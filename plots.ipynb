Loading the Data
# Import necessary libraries
import pandas as pd
import matplotlib.pyplot as plt

# Load the cleaned electric vehicle dataset
df = pd.read_csv("clean_ev_data.csv")
Distribution of Electric Vehicle Types
# Count how many vehicles fall under each electric vehicle type (e.g., BEV, PHEV)
ev_type_counts = df['Electric_Vehicle_Type'].value_counts()

# Plot the distribution as a bar chart
plt.figure(figsize=(8, 6))
ev_type_counts.plot(kind='bar', color='skyblue')
plt.title('Distribution of Electric Vehicle Types')
plt.xlabel('Vehicle Type')
plt.ylabel('Number of Vehicles')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
Top 10 Makes of Electric Vehicles
# Get the top 10 most common EV brands (e.g., Tesla, Nissan)
top_makes = df['Make'].value_counts().nlargest(10)

# Plot the result as a bar chart
plt.figure(figsize=(8, 6))
top_makes.plot(kind='bar', color='lightgreen')
plt.title('Top 10 Electric Vehicle Makes')
plt.xlabel('Vehicle Make')
plt.ylabel('Number of Vehicles')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
EV Count by Model Year
# Count the number of EVs for each model year
model_year_counts = df['Model_Year'].value_counts().sort_index()

# Plot the EV count per year as a bar chart
plt.figure(figsize=(10, 6))
model_year_counts.plot(kind='bar', color='coral')
plt.title('Electric Vehicle Count by Model Year')
plt.xlabel('Model Year')
plt.ylabel('Number of Vehicles')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
Average Electric Range by EV Type
# Calculate the average electric driving range for each EV type
avg_range_by_type = df.groupby('Electric_Vehicle_Type')['Electric_Range'].mean()

# Plot the average range for BEVs and PHEVs
plt.figure(figsize=(8, 6))
avg_range_by_type.plot(kind='bar', color='mediumseagreen')
plt.title('Average Electric Range by Vehicle Type')
plt.xlabel('Electric Vehicle Type')
plt.ylabel('Average Electric Range (miles)')
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()
Top 10 Cities with the Most Electric Vehicles
# Get the top 10 cities in the dataset with the highest number of EVs
top_cities = df['City'].value_counts().nlargest(10)

# Plot city EV counts
plt.figure(figsize=(10, 6))
top_cities.plot(kind='bar', color='slateblue')
plt.title('Top 10 Cities with the Most Electric Vehicles')
plt.xlabel('City')
plt.ylabel('Number of Vehicles')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
